@startuml
title «АгроТех Х» — Контекстная диаграмма

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(admin, "Администратор системы", "Управление пользователями и настройками")
Person(manager, "Руководитель хозяйства", "Принимает управленческие решения на основе аналитики")
Person(ops, "Оператор фермы", "Осуществляет ежедневный мониторинг состояния животных и оборудования")
Person(vet, "Ветеринарный врач", "Контролирует здоровье поголовья, получает уведомления о проблемах")

System(farms, "Фермерские комплексы", "Внешние управляемые агрокомплексы")

System(agrotech, "АгроТех Х", "Система управления фермами")

Rel(admin, agrotech, "Настраивает пользователей и параметры системы")
Rel(manager, agrotech, "Задаёт стратегические цели и ограничения")
Rel(farms, agrotech, "Отправляет телеметрию и операционные данные")
Rel(agrotech, farms, "Отправляет управляющие команды")
Rel(farms, ops, "Отправляет оповещения")
Rel(farms, vet, "Отправляет оповещения")

@enduml