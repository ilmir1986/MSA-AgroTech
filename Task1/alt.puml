@startuml
title «АгроТех Х» — Контекстная диаграмма

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(admin, "Администратор системы", "Управление пользователями и настройками")
Person(director, "Директор", "Стратегическое планирование и контроль")
Person(accountant, "Бухгалтер", "Финансовые расчёты и отчётность")
Person(analytic, "Аналитик", "Формирование операционных и аналитических отчётов")

System_Ext(farms, "Фермы", "Внешние управляемые агрокомплексы")
System_Ext(agroprom, "АгроПром X", "Имеющаяся цифровая платформа")

System(agrotech, "АгроТех Х", "Система управления фермами")

Rel(admin, agrotech, "Настраивает пользователей и параметры системы")
Rel(director, agrotech, "Задаёт стратегические цели и ограничения")
Rel(accountant, agrotech, "Получает финансовые данные")
Rel(analytic, agrotech, "Запрашивает аналитические данные")
Rel(farms, agrotech, "Отправляет телеметрию и операционные данные")
Rel(agrotech, farms, "Отправляет управляющие команды")
Rel(agrotech, agroprom, "Использует инфрастуктуру и готовые программные компоненты")

@enduml